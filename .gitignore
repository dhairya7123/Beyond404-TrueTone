node_modules/
**/node_modules/
dist/
**/dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
**/.venv/
env/
venv/
ENV/

# Logs
*.log
**/stdout.log
**/stderr.log
**/server_out.log
**/server_err.log

# Environment & local settings
.env
.env.local
.env.*.local

# IDEs & OS
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Generated runtime certificates (large test runs)
**/forensic_certificate.json
**/forensic_certificate.pdf
